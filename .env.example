# =============================================================================
# Database — Prisma connects here. PostgreSQL (Neon, Supabase, or any PG host).
# Get DATABASE_URL from your database provider's connection settings.
# DIRECT_URL is only required for Prisma Migrate on serverless DBs.
# =============================================================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# =============================================================================
# JWT secret for admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production, always set this explicitly. The dev fallback in src/lib/auth.js
# is unsafe and only used when this env var is missing.
# =============================================================================
JWT_SECRET="change-me-in-production-please-generate-a-real-secret"

# =============================================================================
# Admin credentials used by `npm run prisma:seed` to create the default
# admin user (used to log into /admin/login). NEVER commit real values.
# Pick a strong password before deploying.
# =============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-set-a-strong-password"
